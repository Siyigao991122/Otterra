# Supabase (for waitlist)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SECRET_SERVICE_ROLE_KEY>
# If Supabase is down or URL is wrong, set to 1 so /api/products serves local /public/models GLBs (non-dev builds only; dev uses fallback automatically when network fails).
# PRODUCTS_OFFLINE_FALLBACK=1

# OpenAI (for /api/design AI layout generation)
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# fal.ai (for scripts/fal_trellis_generate_glb.mjs)
FAL_KEY=<YOUR_FAL_KEY_ID>:<YOUR_FAL_KEY_SECRET>

# Email accounts allowed to use the admin dashboard (comma-separated).
# The dashboard uses a Supabase passwordless email OTP.
ADMIN_EMAILS=you@example.com

# Closed-beta gate (middleware.ts). Set ACCESS_TOKEN_SECRET (any long random
# string, used to sign the session cookie) to require an invite code — entered
# once at /access — before the floor-plan studio (/design), protected APIs, or
# protected APIs are reachable. The landing page (/), /admin login, /waitlist,
# and /api/waitlist stay
# public. Leave unset to disable the gate entirely (e.g. local dev).
# ACCESS_TOKEN_SECRET=<CHOOSE_A_LONG_RANDOM_STRING>
#
# Per-person codes are generated at /admin/invites and stored in the
# invite_codes table (supabase/migrations/20260809_invite_codes.sql and
# 20260908_invite_codes_email.sql — run both manually in the Supabase SQL
# editor once). SITE_ACCESS_CODE below is an optional single "owner" code
# that always works, useful for your own access without generating yourself
# an invite.
# SITE_ACCESS_CODE=choose-your-own-owner-code

# Resend (lib/sendInviteEmail.ts) — lets /admin/invites email a generated code
# straight to someone instead of you copy-pasting it. Sign up at resend.com,
# create an API key. Until you verify your own sending domain there, Resend's
# sandbox only delivers to the email address on your Resend account — fine
# for testing, not for real invites. RESEND_FROM_EMAIL needs a domain you've
# verified with Resend (e.g. "Otterra <invites@yourdomain.com>"); until then
# leave it unset to use Resend's shared sandbox address.
# RESEND_API_KEY=<YOUR_RESEND_API_KEY>
# RESEND_FROM_EMAIL=Otterra <invites@yourdomain.com>

# Used to build the link in invite emails (defaults to https://otterra.ai if unset).
# NEXT_PUBLIC_SITE_URL=https://otterra.ai
