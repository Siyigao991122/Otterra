# Supabase (for waitlist)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SECRET_SERVICE_ROLE_KEY>
# If Supabase is down or URL is wrong, set to 1 so /api/products serves local /public/models GLBs (non-dev builds only; dev uses fallback automatically when network fails).
# PRODUCTS_OFFLINE_FALLBACK=1

# OpenAI (for /api/design AI layout generation)
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# fal.ai (for scripts/fal_trellis_generate_glb.mjs)
FAL_KEY=<YOUR_FAL_KEY_ID>:<YOUR_FAL_KEY_SECRET>

# Admin API key for protected endpoints (PATCH /api/products/:id, /api/admin/invites*).
# NEXT_PUBLIC_ADMIN_API_KEY is the same value exposed client-side so app/admin/* pages
# can send it back as the x-admin-api-key header — keep the two in sync.
ADMIN_API_KEY=<CHOOSE_A_SECRET>
NEXT_PUBLIC_ADMIN_API_KEY=<SAME_VALUE_AS_ADMIN_API_KEY>

# Closed-beta gate (middleware.ts). Set ACCESS_TOKEN_SECRET (any long random
# string, used to sign the session cookie) to require an invite code — entered
# once at /access — before the floor-plan studio (/design), protected APIs, or
# /admin are reachable. The landing page (/), /waitlist, and /api/waitlist stay
# public. Leave unset to disable the gate entirely (e.g. local dev).
# ACCESS_TOKEN_SECRET=<CHOOSE_A_LONG_RANDOM_STRING>
#
# Per-person codes are generated at /admin/invites and stored in the
# invite_codes table (supabase/migrations/20260809_invite_codes.sql — run
# manually in the Supabase SQL editor once). SITE_ACCESS_CODE below is an
# optional single "owner" code that always works, useful for your own access
# without generating yourself an invite.
# SITE_ACCESS_CODE=choose-your-own-owner-code
